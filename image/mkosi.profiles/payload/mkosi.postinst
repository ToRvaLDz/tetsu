#!/usr/bin/env bash
# Payload customisation, run by mkosi in its sandbox: the image is $BUILDROOT,
# and `mkosi-chroot` runs a command inside it.
set -euo pipefail
root=$BUILDROOT

# sudoers drop-ins must be 0440; git cannot carry that mode.
chmod 0440 "$root/etc/sudoers.d/10-wheel"

# Locales named by the installer's keyboard table (etc/locale.gen is staged
# by image/build from crates/tetsu-installer-core/src/keyboard.rs).
if [ -s "$root/etc/locale.gen" ]; then
  mkosi-chroot locale-gen
fi

# A pacman mirror: the Arch package ships the mirrorlist fully commented out.
if ! grep -q '^Server' "$root/etc/pacman.d/mirrorlist"; then
  printf 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n' >"$root/etc/pacman.d/mirrorlist"
fi

# tetsu-base must be explicitly installed (the base set is its depends), and
# mkosi's local package repository must not leak into the image.
mkosi-chroot pacman -Qqe tetsu-base >/dev/null \
  || { echo "tetsu-base is not an explicitly installed package" >&2; exit 1; }
if grep -q '^\[mkosi\]' "$root/etc/pacman.conf"; then
  echo "the payload pacman.conf carries mkosi's local [mkosi] repository" >&2
  exit 1
fi

# Units are enabled through usr/lib/systemd/system-preset/50-tetsu.preset:
# mkosi runs `systemctl preset-all` after this script.
ln -sf ../run/systemd/resolve/stub-resolv.conf "$root/etc/resolv.conf"
