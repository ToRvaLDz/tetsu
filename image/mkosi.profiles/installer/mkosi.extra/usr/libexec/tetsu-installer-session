#!/usr/bin/env bash
# One installer session on the console given as $1 (tty1, ttyS0).
# Several consoles may run a session; only one runs the installer at a time,
# the others wait for it (a second one could wipe a disk under the first).
set -uo pipefail

# Ctrl-C reaches the whole foreground group: the installer handles it, the
# session must outlive it (a handler, unlike "ignore", is reset in children).
trap : INT

tty=${1:?usage: tetsu-installer-session TTY}
medium=/usr/share/tetsu/medium

# A serial port that is not there (most laptops): nothing to do.
case "$tty" in
  ttyS*) [ -e "/sys/class/tty/$tty/device" ] || exit 0 ;;
esac

# The kernel's primary console (the last console= of the command line; with
# the medium's command line it is the serial line when the machine has one,
# else the screen) wins the race; the others give it a head start.
primary=$(awk '{print $NF}' /sys/class/tty/console/active 2>/dev/null || true)
[ "$primary" = tty0 ] && primary=tty1
[ "$tty" = "$primary" ] || sleep 3

status_file=/run/tetsu-installer.status
exec 9>/run/tetsu-installer.lock
waited=0
if ! flock -n 9; then
  echo "The installer is running on another console ($primary); waiting for it."
  flock 9
  waited=1
fi

if [ "$waited" = 1 ] && [ -s "$status_file" ]; then
  # The other console ran the installer to its end: running it again here
  # would wipe the system it just installed.
  exec 9>&-
  echo
  echo "The installer ran on another console and ended (status $(cat "$status_file"))."
  echo "This is a maintenance shell on the installation medium: 'reboot' restarts,"
  echo "'tetsu-installer --medium $medium' runs the installer again."
  exec /usr/bin/bash --login
fi

# fd 9 stays closed for the installer: the lock is the session's.
/usr/bin/tetsu-installer --medium "$medium" 9>&-
status=$?
echo "$status" >"$status_file"
exec 9>&-

echo
echo "The installer ended (status $status). This is a maintenance shell on the"
echo "installation medium: 'reboot' restarts, 'tetsu-installer --medium $medium' retries."
exec /usr/bin/bash --login
