#!/usr/bin/env bash
# Download the latest Arch Linux ISO into the tetsu VM cache and verify it.
set -euo pipefail

MIRROR=${TETSU_ARCH_MIRROR:-https://geo.mirror.pkgbuild.com/iso/latest}
ISO_NAME=archlinux-x86_64.iso
DEST=${TETSU_VM_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/tetsu/vm}

die() { printf 'fetch-arch-iso: error: %s\n' "$*" >&2; exit 1; }

for tool in curl sha256sum; do
  command -v "$tool" >/dev/null 2>&1 || die "'$tool' not found in PATH"
done

mkdir -p "$DEST"

# verify [FILE]: check FILE (default the final ISO) against the sha256 listed
# for the ISO in sha256sums.txt.
verify() {
  local file=${1:-$DEST/$ISO_NAME} want got
  [ -f "$file" ] && [ -f "$DEST/sha256sums.txt" ] || return 1
  want=$(grep -E "[[:space:]]\*?$ISO_NAME\$" "$DEST/sha256sums.txt" | awk '{print $1}')
  [ -n "$want" ] || return 1
  got=$(sha256sum "$file" | awk '{print $1}')
  [ "$want" = "$got" ]
}

# Always refresh the checksum list: it tells whether the cached ISO is current.
curl -fsSL --retry 3 -o "$DEST/sha256sums.txt.new" "$MIRROR/sha256sums.txt" \
  || die "could not download $MIRROR/sha256sums.txt"
mv "$DEST/sha256sums.txt.new" "$DEST/sha256sums.txt"

if verify; then
  echo "ISO already present and verified: $DEST/$ISO_NAME"
  exit 0
fi

# A final ISO that fails verification is stale or corrupt: never resume onto it.
rm -f "$DEST/$ISO_NAME"

# Download to a .part file (resume is allowed there only), verify it against
# the fresh checksum list, then move it into place.
PART="$DEST/$ISO_NAME.part"
echo "Downloading $MIRROR/$ISO_NAME ..."
rc=0
curl -fL --retry 3 -C - -o "$PART" "$MIRROR/$ISO_NAME" || rc=$?
if [ "$rc" -ne 0 ]; then
  # 33: the server cannot resume from this .part (stale or already complete).
  [ "$rc" -ne 33 ] || rm -f "$PART"
  die "download failed (curl exit $rc)"
fi

if ! verify "$PART"; then
  rm -f "$PART"
  die "checksum mismatch, removed the partial download"
fi
mv "$PART" "$DEST/$ISO_NAME"
echo "ISO downloaded and verified: $DEST/$ISO_NAME"
