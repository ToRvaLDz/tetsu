# The secrets vault: metadata and writes, never a value.
#
# No call of this interface returns a secret value, and none ever will:
# a value leaves the vault only inside the broker, bound to the host or
# tool it was stored for. Add, Rotate and Remove from the agent unit are
# rejected with PermissionDenied. Every call is audited in the journal.
interface org.tetsu.secrets.v1

type SecretInfo (
  # The name chosen when the secret was added; compare for equality only.
  id: string,
  # How the broker presents the value upstream.
  kind: (bearer, header, basic),
  # kind header: the header the value is sent in. Null for the others.
  header_name: ?string,
  # The only upstream host (optionally host:port) the value may be sent to.
  host: string,
  # Tool ids a spawned tool may receive the value as, empty for none.
  allowed_tools: []string,
  # When the secret was added.
  created_at: string,
  # When the value was last replaced, null when never.
  rotated_at: ?string,
  # When the broker last used the value since it started, null when it did
  # not. Not kept across a restart: the audit journal is the record.
  last_used_at: ?string,
  # How many times the broker used the value since it started.
  use_count: int
)

type SecretEvent (
  kind: (initial, added, changed, removed),
  # initial: every secret.
  secrets: ?[]SecretInfo,
  # added, changed: the full new state of the secret.
  secret: ?SecretInfo,
  # removed
  id: ?string
)

# Lists the secrets: names and bindings, never values.
method ListSecrets() -> (secrets: []SecretInfo)

# Streams secret changes: `initial` first, then deltas. A use of a secret
# is a `changed`.
method WatchSecrets() -> (event: SecretEvent)

# Stores a new secret bound to one upstream host. The value is never
# returned, logged or traced.
# @capability secrets.manage
method Add(
  # The name: lowercase letters, digits, `-` and `_`, up to 64.
  id: string,
  # How the value is presented upstream: a bearer token, in a named
  # header, or as basic authentication.
  kind: (bearer, header, basic),
  # Required for kind header: the header name. Null for the others.
  header_name: ?string,
  # The upstream host the value may be sent to, lowercase, optionally with
  # a port; no scheme or path.
  host: string,
  # Tool ids that may receive the value in a spawned process. Null for
  # none.
  allowed_tools: ?[]string,
  # The secret value.
  # @sensitive
  value: string
) -> (secret: SecretInfo)

# Replaces the value of a secret; its binding stays. The value is never
# returned, logged or traced.
# @destructive
# @capability secrets.manage
method Rotate(
  # The secret to rotate.
  id: string,
  # The new value.
  # @sensitive
  value: string
) -> (secret: SecretInfo)

# Deletes a secret and its value for good.
# @destructive
# @capability secrets.manage
method Remove(
  # The secret to delete.
  id: string
) -> ()

# No secret has this id.
# @permanent
error SecretNotFound (id: string)

# A secret with this id exists already.
# @permanent
error SecretExists (id: string)

# The vault or the audit journal cannot be written; nothing changed.
# @transient
error VaultUnavailable ()

# The caller may not use this interface, or is the agent unit trying to
# write.
# @permanent
error PermissionDenied ()
