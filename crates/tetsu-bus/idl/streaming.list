# Streaming (`more`) methods of the bus contract. The IDL cannot express
# `more`, so this list names them: one `<interface>.<Method>` per line.
# Every Watch* method is streaming and must be listed. The contract suite
# rejects an entry that names no method; moving a method into or out of
# the list is a breaking change.
org.tetsu.comp.clipboard.v1.WatchClipboard
org.tetsu.comp.config.v1.WatchConfig
org.tetsu.comp.output.v1.WatchOutputs
org.tetsu.comp.render.v1.WatchRender
org.tetsu.comp.render.v1.WatchRenderStats
org.tetsu.comp.session.v1.WatchSession
org.tetsu.comp.window.v1.WatchWindows
org.tetsu.comp.workspace.v1.WatchWorkspaces
org.tetsu.notify.v1.Show
org.tetsu.notify.v1.WatchPending
org.tetsu.tx.v1.Install
org.tetsu.tx.v1.InstallFromAur
org.tetsu.tx.v1.Remove
org.tetsu.tx.v1.Rollback
org.tetsu.tx.v1.Update
org.tetsu.tx.v1.WatchTransactions
