[Unit]
Description=Check the boot is healthy and record it as good
# Boot counting: reaching boot-complete.target lets systemd-bless-boot rename
# the ESP entry. A failed check fails the target, so the entry stays on trial.
After=multi-user.target
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/tetsu-boot-check

[Install]
WantedBy=multi-user.target
RequiredBy=boot-complete.target
