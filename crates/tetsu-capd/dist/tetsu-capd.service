# Installed as /usr/lib/systemd/user/tetsu-capd.service. tetsu-tx and the
# session daemons call Check on its socket, %t/tetsu/org.tetsu.cap.v1.
[Unit]
Description=Tetsu capability daemon
Documentation=https://github.com/ToRvaLDz/tetsu
PartOf=graphical-session.target
Wants=tetsu-notifyd.service
After=graphical-session.target tetsu-notifyd.service

[Service]
ExecStart=/usr/bin/tetsu-capd
Restart=on-failure
Slice=session.slice

[Install]
WantedBy=graphical-session.target
