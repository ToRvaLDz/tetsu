# Installed as /usr/lib/systemd/user/tetsu-notifyd.socket. systemd binds the
# session bus socket and passes it to tetsu-notifyd by name (LISTEN_FDNAMES).
[Unit]
Description=Tetsu notification server socket (org.tetsu.notify.v1)
Documentation=https://github.com/ToRvaLDz/tetsu

[Socket]
ListenStream=%t/tetsu/org.tetsu.notify.v1
FileDescriptorName=org.tetsu.notify.v1
# Only the session user connects.
SocketMode=0600
DirectoryMode=0700
Symlinks=%t/tetsu/registry/org.tetsu.notify.v1
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
