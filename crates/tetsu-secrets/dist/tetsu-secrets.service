# The secrets vault broker: the only process that opens the vault.
#
# systemd decrypts the vault key (sealed by tetsu-secrets-init.service)
# into $CREDENTIALS_DIRECTORY when the user manager starts this unit at
# login. The key is in the unit's private credentials directory and nowhere
# else.
[Unit]
Description=Tetsu secrets vault
Documentation=https://github.com/ToRvaLDz/tetsu/issues/58
Requires=tetsu-secrets-init.service
After=tetsu-secrets-init.service

[Service]
Type=simple
ExecStart=/usr/bin/tetsu-secrets serve
LoadCredentialEncrypted=tetsu-secrets.vault-key
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
