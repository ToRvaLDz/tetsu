# The secrets vault broker: the only process that opens the vault.
#
# Socket activated (tetsu-secrets.socket, under default.target): the first
# connection starts this unit, with or without a login session. systemd
# then decrypts the vault key (sealed by tetsu-secrets-init.service) into
# $CREDENTIALS_DIRECTORY and the broker unlocks the vault from it. The key
# is in the unit's private credentials directory and nowhere else.
[Unit]
Description=Tetsu secrets vault
Documentation=https://github.com/ToRvaLDz/tetsu/issues/58
Requires=tetsu-secrets.socket tetsu-secrets-init.service
After=tetsu-secrets.socket tetsu-secrets-init.service

[Service]
Type=simple
ExecStart=/usr/bin/tetsu-secrets serve
LoadCredentialEncrypted=tetsu-secrets.vault-key
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2

[Install]
Also=tetsu-secrets.socket
