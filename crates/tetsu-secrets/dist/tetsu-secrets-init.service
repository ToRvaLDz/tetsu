# First login: create the vault key and seal it with systemd-creds.
# Skipped once the sealed key exists; it never replaces one.
[Unit]
Description=Create the Tetsu secrets vault key
Documentation=https://github.com/ToRvaLDz/tetsu/issues/58
ConditionPathExists=!%E/credstore.encrypted/tetsu-secrets.vault-key

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/tetsu-secrets init
UMask=0077
