# The socket of the secrets vault broker (tetsu-secrets.service).
#
# systemd listens here from the user manager's start, so it works with no
# login session; the first connection starts the broker, which unlocks the
# vault from its sealed credential. The user sockets.target is pulled in by
# default.target, never by graphical-session.target.
[Unit]
Description=Tetsu secrets vault socket
Documentation=https://github.com/ToRvaLDz/tetsu/issues/58

[Socket]
ListenStream=%t/tetsu/org.tetsu.secrets.v1
SocketMode=0600
DirectoryMode=0700

[Install]
WantedBy=sockets.target
